# Copy to `.env` (same directory, gitignored, never committed) and fill in
# real values. The collector loads `.env` automatically on every run;
# exported variables override it. Fail-fast states: CONFIG_OK,
# MISSING_REQUIRED_CONFIG (exit 2, no polling), SKIPPED_OPTIONAL_CONFIG
# (per-source heartbeat, never a failure).
#
# MIRO_CONTACT: required. Identification in the EDGAR User-Agent.
# FRED_API_KEY: optional. Leave empty to keep FRED as SKIPPED_CONFIG.
# OPENROUTER_API_KEY: optional. Research model provider key; absent blocks
# live model paths, never a crash. Fill only when live model work is
# authorized.

# Required: SEC fair-access identification in the EDGAR User-Agent.
# Use a real reachable contact or EDGAR may return HTTP 403.
MIRO_CONTACT=your-name@example.com

# Optional: FRED collector. Leave empty to keep FRED as SKIPPED_CONFIG (expected).
FRED_API_KEY=

# Optional: OpenRouter provider key. Leave empty until live model work is
# authorized (absent blocks live model paths, never a crash).
OPENROUTER_API_KEY=

# Live research model (OpenRouter slug). Pinned only when live model work is
# authorized; unknown or unpriced models stay fail-closed.
RESEARCH_MODEL_ID=meta/muse-spark-1.3-contributor

# Optional: BEA API UserID (36-char GUID from apps.bea.gov/api/signup).
# Leave empty to keep BEA as SKIPPED_CONFIG (expected).
BEA_USER_ID=

# Optional: Alpaca PAPER keypair (paper-api.alpaca.markets ONLY — never
# live keys here). Leave empty to keep Alpaca as SKIPPED_CONFIG.
ALPACA_KEY_ID=
ALPACA_SECRET=
