[Unit]
Description=MiroHedge paper decision loop (Alpaca paper only)
After=network-online.target
Wants=network-online.target

[Service]
User=mirotrade
EnvironmentFile=/etc/mirohedge/env
WorkingDirectory=/opt/mirohedge
ExecStart=/opt/mirohedge/kernel/g0_paper_loop /var/lib/mirohedge/g0 /opt/mirohedge/collector/session_calendar.json --ticks 0 --interval-s 60
Restart=on-failure
RestartPreventExitStatus=2 3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mirohedge/g0
PrivateTmp=true

[Install]
WantedBy=multi-user.target
