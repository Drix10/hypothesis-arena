# provider.env.example — Phase-D deployment box 4 credential placement.
#
# Copy to provider.env (NEVER commit the copy) on the Linux deployment host
# in the miroresearch home (mode 600). The supervisor sources it into the
# research-plane environment only; the trading user never sees it.
# Missing file or empty values -> ConfigBlocked at construction (proven by
# sandbox/config-probe.py). No live values below — placeholders only.
RESEARCH_MODEL_ID=
RESEARCH_MODEL_API_BASE=
RESEARCH_MODEL_API_KEY=
RESEARCH_EGRESS_PROXY=http://egress-proxy:3128
# Worst-leg USD per 1k tokens (governor sole pricing authority; unpriced
# models never run). Fill per pinned model at build.
RESEARCH_PRICING_JSON={"<model_id>": 0.0}
# Free-tier source keys (research user env only; trading user never sees).
FRED_API_KEY=
ALFRED_API_KEY=
